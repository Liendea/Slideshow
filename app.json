{
  "expo": {
    "name": "Slideshow",
    "slug": "slideshow",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F0F11",
    "ios": {
      "supportsTablet": true,
      "isTabletOnly": true,
      "bundleIdentifier": "se.gwstudios.bildspel",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F0F11",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-image",
      [
        "expo-media-library",
        {
          "photosPermission": "Slideshow needs access to your photos and albums to show them in the slideshow.",
          "savePhotosPermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Slideshow needs access to your photos to show them in the slideshow.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
